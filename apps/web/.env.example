# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# better-auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (defaults point at the mailpit container from docker-compose)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="App <noreply@example.com>"

# LeanIX / Katalog
LEANIX_BASE_URL=https://ktso.leanix.net
LEANIX_WORKSPACE=eamktsoLive
# API-Token des technischen Benutzers. Leer = Demo-Modus (apps/web/data/demo-catalog.json)
LEANIX_API_TOKEN=
# Optional: leanix | demo (Standard: leanix, wenn ein Token gesetzt ist)
CATALOG_SOURCE=
CATALOG_SYNC_INTERVAL_MINUTES=15
CATALOG_MIN_RATIO=0.5
CATALOG_STALE_AFTER_HOURS=24
CATALOG_SHOW_PERSONS=false
# Standard-Aktion für Leistungen ohne Bestell-/Anfrage-Ressource
CATALOG_FALLBACK_REQUEST_URL=
CATALOG_FALLBACK_REQUEST_LABEL="Anfrage an den Service Desk"
