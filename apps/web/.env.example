# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# better-auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: IPs/CIDR-Bereiche der Reverse Proxies (kommagetrennt). Nur nötig,
# wenn der Proxy X-Forwarded-For ergänzt statt überschreibt (siehe README, Betrieb).
AUTH_TRUSTED_PROXIES=

# LeanIX / Katalog
LEANIX_BASE_URL=https://ktso.leanix.net
LEANIX_WORKSPACE=eamktsoLive
# API-Token des technischen Benutzers. Leer = Demo-Modus (apps/web/data/demo-catalog.json)
LEANIX_API_TOKEN=
# Optional: leanix | demo (Standard: leanix, wenn ein Token gesetzt ist).
# Leere Werte gelten als nicht gesetzt.
# CATALOG_SOURCE=leanix
CATALOG_SYNC_INTERVAL_MINUTES=15
# Schrumpf-Schutz: neuer Stand wird abgelehnt, wenn er weniger als 50 % der
# Leistungen (bzw. Aktionen) enthält UND mehr als 5 davon wegfallen.
CATALOG_MIN_RATIO=0.5
CATALOG_SHRINK_TOLERANCE=5
CATALOG_STALE_AFTER_HOURS=24
CATALOG_SHOW_PERSONS=false
# Services ohne Leistung im Kanal anzeigen (vorläufig: false = ausblenden)
CATALOG_SHOW_EMPTY_SERVICES=false
# Hosts, für die Ressourcen-Links mit http: erlaubt sind (kommagetrennt); sonst nur https:
CATALOG_HTTP_ALLOWED_HOSTS=
# Zentraler Kontakt (Service Desk) für Leistungen ohne Bestell-/Anfrage-Ressource,
# Services ohne Leistungen, die Fusszeile und die Seite «Katalog nicht verfügbar».
# Fachlich noch offen (Konzept, offene Frage 2): bitte die echte URL bzw. Adresse
# eintragen. Leer = kein Link, nur Hinweis auf die verantwortliche Stelle.
# Erlaubt: https://… (z. B. ky2help- oder SmartForm-Formular), mailto:… oder tel:…
# Ein ungültiger Wert bricht den Start mit einer Fehlermeldung ab.
CATALOG_FALLBACK_REQUEST_URL=
CATALOG_FALLBACK_REQUEST_LABEL="Anfrage an den Service Desk"
# Optional zusätzlich: E-Mail-Adresse und Telefonnummer des Service Desk,
# z. B. CATALOG_SUPPORT_PHONE="032 627 xx xx"
CATALOG_SUPPORT_EMAIL=
CATALOG_SUPPORT_PHONE=
# Optional: LeanIX-ID der Ebene-1-Kategorie «Business IT-Servicekatalog».
# Leer = Wert aus lib/leanix/model.ts (Workspace eamktsoLive).
CATALOG_ROOT_ID=
