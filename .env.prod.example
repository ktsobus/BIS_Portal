# Used by docker-compose.prod.yml:
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Public hostname. nginx-proxy routes it to the app and acme-companion gets a
# TLS certificate for it, so DNS must point at this host.
APP_DOMAIN=app.example.com

# External Docker network that nginx-proxy is attached to.
PROXY_NETWORK=nginx-proxy

# Postgres (internal to the compose network)
POSTGRES_USER=app
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=app

# better-auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# SMTP for outgoing mail
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="App <noreply@example.com>"
