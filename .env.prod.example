# Used by docker-compose.prod.yml:
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Public hostname. nginx-proxy routes it to the app and acme-companion gets a
# TLS certificate for it, so DNS must point at this host.
APP_DOMAIN=app.example.com

# External Docker network that nginx-proxy is attached to.
PROXY_NETWORK=nginx-proxy

# Postgres (internal to the compose network)
POSTGRES_USER=app
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=app

# better-auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# LeanIX / Katalog (Details und Standardwerte: apps/web/.env.example)
# API-Token des technischen Benutzers (nur lesen). Leer = Demo-Modus.
LEANIX_API_TOKEN=
LEANIX_BASE_URL=https://ktso.leanix.net
LEANIX_WORKSPACE=eamktsoLive
CATALOG_SYNC_INTERVAL_MINUTES=15
CATALOG_SHOW_PERSONS=false
# Zentraler Kontakt (Service Desk) für Leistungen ohne Bestell-/Anfrageweg,
# Fusszeile und Ausfallseite. Fachlich noch offen (Konzept, offene Frage 2).
# Erlaubt: https://…, mailto:… oder tel:…; leer = kein Link.
CATALOG_FALLBACK_REQUEST_URL=
CATALOG_FALLBACK_REQUEST_LABEL="Anfrage an den Service Desk"
CATALOG_SUPPORT_EMAIL=
CATALOG_SUPPORT_PHONE=

# Optional: IPs/CIDR-Bereiche der Reverse Proxies, wenn sie X-Forwarded-For
# ergänzen (nginx-proxy: $proxy_add_x_forwarded_for). Beispiel: 172.18.0.0/16
AUTH_TRUSTED_PROXIES=
