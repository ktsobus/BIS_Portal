# Werte für docker-compose.prod.yml (Betrieb: docs/betrieb.md)
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# Die Datei dient Compose zur Interpolation; in den Container gelangen nur die
# Variablen, die docker-compose.prod.yml ausdrücklich weitergibt. Leere oder
# fehlende Werte erhalten dort den Standardwert; Pflichtwerte (APP_URL,
# POSTGRES_PASSWORD, BETTER_AUTH_SECRET, LEANIX_API_TOKEN) brechen den Start ab.

# --- Adresse und Netz ---------------------------------------------------------
# Öffentliche Adresse des Portals, wie sie im Browser steht (Platzhalter).
# Wird beim Build ins Bundle eingesetzt: nach einer Änderung neu bauen (--build).
APP_URL=https://bits.intra.so.ch
# Adresse und Port, auf denen der Container auf dem Host lauscht. Der
# Reverse-Proxy (TLS) leitet dorthin weiter. 127.0.0.1 = nur lokal erreichbar;
# steht der Reverse-Proxy auf einem anderen Server, die interne Adresse dieses
# Servers eintragen.
APP_BIND=127.0.0.1
APP_PORT=3000

# --- Postgres (nur im internen Compose-Netz) ----------------------------------
POSTGRES_USER=bits
# Erzeugen mit: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=bits

# --- better-auth (Admin-Anmeldung) --------------------------------------------
# Erzeugen mit: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- LeanIX / Katalog ---------------------------------------------------------
# API-Token des technischen LeanIX-Benutzers. Secret: nur in dieser Datei
# (chmod 600), nie im Repo. Workspace-Rolle «Viewer» genügt (nur lesen).
# Beim Erstellen in LeanIX ein Ablaufdatum setzen und vor Ablauf erneuern
# (Token-Rotation: docs/betrieb.md). Pflicht: ohne Token startet Compose nicht.
LEANIX_API_TOKEN=
LEANIX_BASE_URL=https://ktso.leanix.net
LEANIX_WORKSPACE=eamktsoLive
# leanix = Sync mit LeanIX (Standard). demo = mitgelieferter Testdatensatz ohne
# Sync, nur für Vorführungen (LEANIX_API_TOKEN dann mit einem beliebigen Wert).
CATALOG_SOURCE=leanix
# LeanIX-ID der Ebene-1-Kategorie «Business IT-Servicekatalog».
# Leer = Wert aus apps/web/lib/leanix/model.ts (Workspace eamktsoLive).
CATALOG_ROOT_ID=
# Abstand zwischen zwei Syncs in Minuten
CATALOG_SYNC_INTERVAL_MINUTES=15
# Schrumpf-Schutz: neuer Stand wird abgelehnt, wenn er weniger als diesen
# Anteil der Leistungen des bisherigen Stands enthält (0.5 = 50 %).
CATALOG_MIN_RATIO=0.5
# Ab so vielen Stunden ohne erfolgreichen Sync gilt der Katalog als veraltet
# (Hinweis im Admin-Bereich).
CATALOG_STALE_AFTER_HOURS=24
# Personen (Leistungsverantwortliche/r) anzeigen: true | false
CATALOG_SHOW_PERSONS=false
# Standard-Aktion für Leistungen ohne Bestell-/Anfrage-Ressource in LeanIX,
# z. B. Service Desk oder ky2help-Startseite. Leer = keine Standard-Aktion.
CATALOG_FALLBACK_REQUEST_URL=
CATALOG_FALLBACK_REQUEST_LABEL="Anfrage an den Service Desk"

# --- Ausgehender Proxy (Laufzeit) ---------------------------------------------
# Der Container muss https://ktso.leanix.net erreichen (Freigabe in der
# Firewall bzw. im Proxy, offene Frage 6 im Konzept). Leer = direkt.
# HTTPS_PROXY=http://proxy.intra.so.ch:8080
# Ziele ohne Proxy (kommagetrennt). Bei eigenem Wert localhost, 127.0.0.1 und
# postgres behalten; interne Hosts (z. B. SAML-IdP) ergänzen.
# NO_PROXY=localhost,127.0.0.1,postgres

# --- Build ohne Internet (optional) -------------------------------------------
# Basis-Image und npm-Registry aus internen Quellen. Proxy für den Build über
# ~/.docker/config.json («proxies») oder --build-arg HTTPS_PROXY=… setzen.
# NODE_IMAGE=registry.intra.so.ch/library/node:24-alpine
# NPM_REGISTRY=https://npm.intra.so.ch/repository/npm/
# POSTGRES_IMAGE=registry.intra.so.ch/library/postgres:17-alpine

# --- Nur mit docker-compose.nginx-proxy.yml -----------------------------------
# Hostname aus APP_URL, für nginx-proxy (VIRTUAL_HOST)
# APP_DOMAIN=bits.intra.so.ch
# Externes Docker-Netz des nginx-proxy
# PROXY_NETWORK=nginx-proxy
# Nur bei öffentlich erreichbarem Host mit acme-companion, intern leer lassen
# LETSENCRYPT_HOST=
