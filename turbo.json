{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "NEXT_PUBLIC_APP_URL",
    "AUTH_TRUSTED_PROXIES",
    "LEANIX_BASE_URL",
    "LEANIX_WORKSPACE",
    "LEANIX_API_TOKEN",
    "CATALOG_SOURCE",
    "CATALOG_ROOT_ID",
    "CATALOG_SYNC_INTERVAL_MINUTES",
    "CATALOG_MIN_RATIO",
    "CATALOG_STALE_AFTER_HOURS",
    "CATALOG_SHOW_PERSONS",
    "CATALOG_FALLBACK_REQUEST_URL",
    "CATALOG_FALLBACK_REQUEST_LABEL",
    "CATALOG_SHRINK_TOLERANCE",
    "CATALOG_SHOW_EMPTY_SERVICES",
    "CATALOG_HTTP_ALLOWED_HOSTS",
    "CATALOG_SUPPORT_EMAIL",
    "CATALOG_SUPPORT_PHONE",
    "CATALOG_IT_DATABASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": ["NEXT_RUNTIME", "NEXT_PHASE"]
}
